{
  // ML Training Configuration
  // This config controls ML pipeline behavior independently from data generation
  // The data generation config is copied with each dataset for reproducibility
  "experiment": {
    "name": "grid_localization_ml",
    "description": "ML-based localization from channel metrics",
    "random_seed": 42
  },
  "data_split": {
    // Options: 'random' or 'temporal' (sequential to prevent data leakage)
    "method": "temporal",
    "test_ratio": 0.2
  },
  "features": {
    // Available features: rss, sinr, cqi, aoa_azimuth, aoa_elevation, timing_advance
    "classification_features": [
      [
        "rss",
        "sinr",
        "cqi"
      ],
      [
        "rss",
        "sinr",
        "cqi",
        "aoa_azimuth",
        "aoa_elevation"
      ]
    ],
    "regression_features": [
      [
        "rss",
        "sinr",
        "cqi"
      ],
      [
        "rss",
        "sinr",
        "cqi",
        "aoa_azimuth",
        "aoa_elevation",
        "timing_advance",
        "path_loss",
        "n_multipath",
        "rms_delay_spread",
        "k_factor"
      ]
    ]
  },
  "realistic_aoa": {
    // Apply realistic impairments to AoA features during training
    // Data generation saves clean AoA; noise added here for flexibility
    "enabled": true,
    // Gaussian noise std in degrees (3-5° typical for antenna arrays)
    "noise_std_deg": 4.0,
    // Quantization resolution in degrees (5° typical for practical systems)
    "quantization_deg": 5.0
  },
  "models": {
    "classification": {
      "static": {
        // Gaussian model for static localization
        "enabled": true
      },
      "transition": {
        // Gaussian model with movement history
        "enabled": true,
        "max_history_values": [
          1,
          2,
          3
        ]
      },
      "random_forest": {
        "enabled": true,
        "n_estimators": 100,
        "random_state": 42,
        "n_jobs": -1
      }
    },
    "regression": {
      "random_forest": {
        "enabled": true,
        "n_estimators": 200,
        "random_state": 42,
        "n_jobs": -1,
        // Targets: distance (m), azimuth (deg), elevation (deg)
        "targets": [
          "distance",
          "aoa_azimuth",
          "aoa_elevation"
        ]
      }
    }
  },
  "evaluation": {
    "metrics": {
      "classification": [
        "accuracy",
        "confusion_matrix",
        "mae_meters"
      ],
      "regression": [
        "mae",
        "rmse",
        "r2"
      ]
    },
    "cross_validation": {
      "enabled": false,
      "n_folds": 5
    }
  },
  "output": {
    "save_results": true,
    "generate_plots": true,
    "save_predictions": true,
    "verbose": true
  }
}