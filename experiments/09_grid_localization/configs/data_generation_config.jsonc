{
  // Configuration for Grid Localization Data Generation
  
  "experiment": {
    "name": "exp13e_corrected_fair_comparison",
    "description": "Static vs Transition-based localization comparison",
    "random_seed": 42
  },
  
  "data_split": {
    // Options: 'random' (original) or 'temporal' (sequential to avoid leakage)
    "method": "temporal", 
    "test_ratio": 0.2
  },

  "grid": {
    "size": 10,
    "spacing": 2.0,
    "ue_height": 1.5,
    "grid_offset": [30, 0],
    "position_jitter": 0.1,
    // Options: 4 (up/down/left/right) or 8 (includes diagonals)
    "neighbor_connectivity": 4
  },
  
  "movement": {
    "steps_per_point": 400,
    "ue_speed": 1.5,
    "starting_point": "center"
  },
  
  "channel": {
    "scenario": "3GPP_38.901_UMa_NLOS",
    "center_frequency": 3e9,
    "bandwidth": 1e8,
    "n_subcarriers": 256,
    "interference_per_sc_dbm": -999
  },
  
  "base_station": {
    "position": [0, 0, 25],
    "tx_power_dbm": 30,
    "interferers": {
      "enabled": true,
      "positions": [
        [150, 0, 25],
        [-150, 0, 25],
        [0, 150, 25]
      ],
      "tx_power_dbm": 30
    }
  },
  
  // ML task configuration (used by Python pipelines)
  "ml_task": {
    // Options: 'classification' (predict grid point) or 'regression' (predict position)
    "type": "classification",
    // For regression mode: predict distance (m), azimuth (deg), elevation (deg) relative to BS
    "regression_targets": ["distance", "aoa_azimuth", "aoa_elevation"],
    "test_ratio": 0.2,
    "metrics": ["RSS", "SINR", "CQI"],
    "max_history_length": 3
  },
  
  "output": {
    "save_results": true,
    "generate_plots": true,
    "save_raw_data": true,
    "verbose": true,
    // Automatically run Python ML pipeline after data generation
    "auto_run_pipeline": false
  }
}
