{
  // Multi-User Heterogeneous Environment — 15x15 Voronoi Grid
  //
  // OBJECTIVE: Test whether transition-based features are robust to
  // device heterogeneity across 5 users with different device profiles.
  //
  // NETWORK SETUP:
  //   - 1 serving BS at grid center [19, 19, 10] — ONLY source for localization
  //   - 2 interfering BSs OUTSIDE the grid, 30m from serving BS:
  //       IBS-1: [-11, 19, 10]  — 30m west  (creates E-W SINR gradient)
  //       IBS-2: [19, -11, 10]  — 30m south (creates N-S SINR gradient)
  //   - Serving BS is always dominant for all 225 grid points
  //   - Features extracted: RSS and SINR from serving BS only
  //
  // Grid geometry:
  //   size=15, spacing=2m, offset=[5,5]
  //   X range: [5, 33],  Y range: [5, 33]
  //   Center: (19, 19)  ← serving BS is here
  //
  // DEVICE PROFILES (5 users — applied via MATLAB override globals):
  //   U1: 4 antennas, 0 dB gain,  1.5 m height  (Flagship A,  seed=100)
  //   U2: 2 antennas, -2 dB gain, 1.5 m height  (Mid-range,   seed=200)
  //   U3: 1 antenna,  -4 dB gain, 1.5 m height  (Budget/Old,  seed=300)
  //   U4: 4 antennas,  0 dB gain, 1.5 m height  (Flagship B,  seed=400)
  //   U5: 2 antennas, -1 dB gain, 0.9 m height  (Tablet/IoT,  seed=500)
  //   U1 and U4 share device params but differ in walk seed — isolates device vs trajectory.

  "experiment": {
    "name": "multi_user_voronoi_15x15",
    "description": "Multi-user heterogeneous 15x15 Voronoi grid — 5 device profiles",
    "random_seed": 42
  },

  "data_split": {
    "method": "temporal",
    "test_ratio": 0.2
  },

  "grid": {
    "size": 15,
    "spacing": 2.0,
    "ue_height": 1.5,
    "grid_offset": [5, 5],
    "position_jitter": 0.1,
    "neighbor_connectivity": 8
  },

  "movement": {
    "steps_per_point": 400,
    "ue_speed": 1.5,
    "starting_point": "center"
  },

  "channel": {
    "scenario": "3GPP_38.901_UMi_NLOS",
    "center_frequency": 3.5e9,
    "bandwidth": 1e8,
    "n_subcarriers": 256,
    "interference_per_sc_dbm": -999,

    "mixed_scenario": {
      "enabled": true,
      "auto_generate": true,

      "area_generator": {
        "num_areas": 4,
        "area_bounds": "auto",
        "transition_width": 3,
        "area_types": [
          "shopping_center",
          "residential",
          "highway",
          "park"
        ]
      },

      "voronoi_cells": []
    }
  },

  "base_station": {
    // Serving BS at CENTER of 15x15 grid
    "position": [19, 19, 10],
    "tx_power_dbm": 30,

    "interferers": {
      "enabled": true,
      // IBS-1: 30m west  → creates east-west SINR gradient
      // IBS-2: 30m south → creates north-south SINR gradient
      // Both well outside grid boundary — serving BS dominant for all 225 points
      "positions": [
        [-11, 19,  10],
        [ 19, -11, 10]
      ],
      "tx_power_dbm": 30
    }
  },

  "ml_task": {
    "type": "classification",
    "test_ratio": 0.2,
    "metrics": ["RSS", "SINR"],
    "max_history_length": 4
  },

  "output": {
    "save_results": true,
    "generate_plots": false,
    "save_raw_data": true,
    "verbose": true,
    "auto_run_pipeline": false
  }
}
