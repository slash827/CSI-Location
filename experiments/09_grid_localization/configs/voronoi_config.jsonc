{
  // Voronoi Heterogeneous Environment - Data Generation Config
  // Uses the SAME format as data_generation_config.jsonc so the existing
  // generate_simulation_data.m and Python pipelines work unchanged.
  //
  // KEY DIFFERENCE: mixed_scenario.enabled = true
  // The Voronoi cells are auto-generated by AreaGenerator at runtime.

  "experiment": {
    "name": "voronoi_heterogeneous",
    "description": "Heterogeneous Voronoi-based environment for transition-based localization",
    "random_seed": 42
  },

  "data_split": {
    "method": "temporal",
    "test_ratio": 0.2
  },

  "grid": {
    "size": 15,
    "spacing": 5.0,
    "ue_height": 1.5,
    "grid_offset": [5, 5],
    "position_jitter": 0.1,
    "neighbor_connectivity": 8
  },

  "movement": {
    "steps_per_point": 100,
    "ue_speed": 1.5,
    "starting_point": "center"
  },

  "channel": {
    // Fallback scenario (used when a position falls outside all cells)
    "scenario": "3GPP_38.901_UMa_NLOS",
    "center_frequency": 3e9,
    "bandwidth": 1e8,
    "n_subcarriers": 256,
    "interference_per_sc_dbm": -999,

    // Voronoi-based mixed scenario
    // When auto_generate = true, AreaGenerator.m creates the cells at runtime
    // and injects them into this config before channel generation.
    "mixed_scenario": {
      "enabled": true,
      "auto_generate": true,

      // AreaGenerator parameters (used only when auto_generate = true)
      "area_generator": {
        "num_areas": 4,
        // Bounds are auto-calculated from grid if set to "auto"
        "area_bounds": "auto",
        "transition_width": 5,
        "area_types": [
          "shopping_center",
          "residential",
          "office",
          "park"
        ]
      },

      // voronoi_cells is populated at runtime by AreaGenerator
      // but can also be set manually (when auto_generate = false)
      "voronoi_cells": []
    }
  },

  "base_station": {
    // BS positioned above the center of the 15x15 grid
    // Grid spans: X [5, 75], Y [5, 75] -> center = [40, 40]
    "position": [40, 40, 25],
    "tx_power_dbm": 30,
    "interferers": {
      "enabled": false,
      "positions": [],
      "tx_power_dbm": 30
    }
  },

  "ml_task": {
    "type": "classification",
    "regression_targets": ["distance", "aoa_azimuth", "aoa_elevation"],
    "test_ratio": 0.2,
    "metrics": ["RSS", "SINR", "CQI"],
    "max_history_length": 3
  },

  "output": {
    "save_results": true,
    "generate_plots": true,
    "save_raw_data": true,
    "verbose": true,
    "auto_run_pipeline": false
  }
}
